---
source: crates/forge-render/tests/snapshots.rs
expression: content
---
# generated by forgebox — edits will be lost; override via etc/templates/
<VirtualHost 127.0.0.1:80>
    ServerName loja.test
    ServerAlias *.loja.test admin.loja.test
    RewriteEngine On
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</VirtualHost>

<VirtualHost 127.0.0.1:443>
    ServerName loja.test
    ServerAlias *.loja.test admin.loja.test
    DocumentRoot "C:/fb-test/www/loja/public"
    Include "C:/fb-test/etc/apache/snippets/ssl-loja.test.conf"
    DirectoryIndex index.php index.html
    Header always set X-Frame-Options "SAMEORIGIN"
    <Directory "C:/fb-test/www/loja/public">
        Options FollowSymLinks
        AllowOverride All
        Require all granted
        FallbackResource /index.php
    </Directory>
    <LocationMatch "/\.ht">
        Require all denied
    </LocationMatch>
    <LocationMatch "/\.env">
        Require all denied
    </LocationMatch>
    <LocationMatch "\.(?:css|js|png|svg|woff2)$">
        Header set Cache-Control "public, max-age=86400"
    </LocationMatch>
    <FilesMatch "\.php$">
        SetHandler "proxy:balancer://php_8_3/"
    </FilesMatch>
    # php-cgi is the only backend on Windows (docs/03 section 2.1). Without GENERIC the
    # SCRIPT_FILENAME is "proxy:fcgi://host:port/C:/..."; with it, "/C:/...". Strip the
    # slash before the drive letter or php-cgi answers "No input file specified.".
    ProxyFCGIBackendType GENERIC
    ProxyFCGISetEnvIf "reqenv('SCRIPT_FILENAME') =~ m#^/([A-Za-z]:/.*)$#" SCRIPT_FILENAME "$1"
    ProxyFCGISetEnvIf "true" FORGEBOX_SITE "loja.test"
    ProxyFCGISetEnvIf "true" APP_ENV "local"
</VirtualHost>
