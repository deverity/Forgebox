---
; generated by forgebox — edits will be lost; override via etc/templates/
; Xdebug for PHP 8.3. xdebug.mode=off keeps the extension loaded but inert.
zend_extension = xdebug

[xdebug]
xdebug.mode = debug
xdebug.start_with_request = trigger
xdebug.client_host = 127.0.0.1
xdebug.client_port = 9003
xdebug.discover_client_host = 0
