; generated by forgebox — edits will be lost; override via etc/templates/
; Xdebug for PHP 8.3, turned on and off per PHP version by Forgebox (php.xdebug).
; The load line and the values come from the extension's manifest (toggle, quick settings).
zend_extension=php_xdebug.dll

[xdebug]
xdebug.mode = "debug"
xdebug.start_with_request = "trigger"
xdebug.client_port = "9003"
xdebug.idekey = "FORGEBOX"
xdebug.client_host = 127.0.0.1
xdebug.discover_client_host = 0
