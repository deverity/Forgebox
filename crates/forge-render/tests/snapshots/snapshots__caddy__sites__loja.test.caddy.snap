---
source: crates/forge-render/tests/snapshots.rs
expression: content
---
# generated by forgebox — edits will be lost; override via etc/templates/
http://loja.test, http://*.loja.test, http://admin.loja.test {
    redir https://{host}{uri} permanent
}

https://loja.test, https://*.loja.test, https://admin.loja.test {
    import forgebox_log
    root * "C:/fb-test/www/loja/public"
    tls "C:/fb-test/certs/sites/loja.test.crt" "C:/fb-test/certs/sites/loja.test.key"
    request_body {
        max_size 256MB
    }
    header X-Frame-Options "SAMEORIGIN"
    @forgebox_deny path_regexp (/\.ht|/\.env)
    respond @forgebox_deny 403
    @forgebox_static_1 path_regexp \.(?:css|js|png|svg|woff2)$
    header @forgebox_static_1 Cache-Control "public, max-age=86400"
    php_fastcgi 127.0.0.1:19083 127.0.0.1:19084 {
        lb_policy least_conn
        env FORGEBOX_SITE "loja.test"
        env APP_ENV "local"
    }
    file_server
}
