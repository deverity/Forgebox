---
source: crates/forge-render/tests/snapshots.rs
expression: content
---
; generated by forgebox — edits will be lost; override via etc/templates/
; Forgebox overlay for PHP 8.3. Scanned through PHP_INI_SCAN_DIR (docs/04).
; Quick settings come from php.settings; everything else is fixed parity with Linux (docs/15 section 7).
extension_dir = "C:/fb-test/bin/php/8.3.36-nts-vs17-x64/ext"

[PHP]
date.timezone = UTC
memory_limit = 1G
upload_max_filesize = 128M
post_max_size = 128M
max_execution_time = 120
display_errors = On
error_reporting = E_ALL
log_errors = On
error_log = "C:/fb-test/logs/php/8.3/error.log"
sys_temp_dir = "C:/fb-test/tmp"
upload_tmp_dir = "C:/fb-test/tmp/uploads"
cgi.fix_pathinfo = 0
default_charset = "UTF-8"

[Session]
session.save_path = "C:/fb-test/tmp/sessions/php/8.3"

[opcache]
zend_extension = opcache
opcache.enable = 1
opcache.enable_cli = 0
opcache.memory_consumption = 192
opcache.interned_strings_buffer = 16
opcache.max_accelerated_files = 20000
opcache.validate_timestamps = 1
opcache.revalidate_freq = 1

; Extensions (docs/04 config.extensions.defaults_on).
extension = curl
extension = mbstring
extension = openssl
extension = pdo_mysql
extension = pdo_sqlite
extension = intl
extension = zip
