---
source: crates/forge-render/tests/snapshots.rs
expression: content
---
# generated by forgebox — edits will be lost; override via etc/templates/
http://app.test {
    redir https://{host}{uri} permanent
}

https://app.test {
    import forgebox_log
    tls "C:/fb-test/certs/sites/app.test.crt" "C:/fb-test/certs/sites/app.test.key"
    # WebSocket upgrades are handled by reverse_proxy itself; flush_interval -1 keeps HMR streams alive.
    reverse_proxy http://127.0.0.1:3000 {
        flush_interval -1
        header_up FORGEBOX_SITE "app.test"
        transport http {
            read_timeout 3600s
        }
    }

    handle_errors {
        @forgebox_down expression {err.status_code} == 502
        handle @forgebox_down {
            rewrite * /_forgebox/starting?host=app.test
            reverse_proxy 127.0.0.1:19000
        }
    }
}
