---
source: crates/forge-render/tests/snapshots.rs
expression: content
---
# forgebox:begin main (hash=2ccaa3ffd5052a81)
worker_processes 1;
error_log "C:/fb-test/logs/nginx/error.log";
pid "C:/fb-test/tmp/nginx/nginx.pid";

events {
    worker_connections 1024;
    # Accept every pending connection at once. On Windows a reload closes the old worker's
    # listening socket and the connections still queued on it fail; draining the queue on
    # each wake-up leaves almost nothing there (docs/06 section 4.1.1).
    multi_accept on;
}

http {
    include "C:/fb-test/bin/nginx/1.30.6/conf/mime.types";
    default_type application/octet-stream;
    sendfile off;
    keepalive_timeout 65;
    # Server-wide body limit (quick setting); each site sets its own in its server block.
    client_max_body_size 128M;
    server_tokens off;
    server_names_hash_bucket_size 128;
    client_body_temp_path "C:/fb-test/tmp/nginx/client_body";
    proxy_temp_path "C:/fb-test/tmp/nginx/proxy";
    fastcgi_temp_path "C:/fb-test/tmp/nginx/fastcgi";
    uwsgi_temp_path "C:/fb-test/tmp/nginx/uwsgi";
    scgi_temp_path "C:/fb-test/tmp/nginx/scgi";

    # Structured access log consumed by forge-metrics (docs/14 section 2).
    log_format forgebox escape=json '{"t":"$msec","host":"$host","s":$status,"rt":$request_time,"ut":"$upstream_response_time","b":$body_bytes_sent,"m":"$request_method","u":"$uri","up":"$upstream_addr"}';
    access_log "C:/fb-test/logs/nginx/access.json" forgebox;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # Proxy sites keep their upstream connections alive (docs/06 section 4.1.1): no
    # Connection header to the app unless the client asks for an upgrade (WebSocket).
    map $http_upgrade $forgebox_upstream_connection {
        default upgrade;
        ''      '';
    }

    # Unknown hosts never fall into a real site.
    server {
        listen 127.0.0.1:80 default_server;
        server_name _;
        return 404;
    }

    # Unknown SNI/Host on TLS: refuse the handshake instead of serving the first TLS site.
    server {
        listen 127.0.0.1:443 ssl default_server;
        server_name _;
        ssl_reject_handshake on;
    }

    include conf.d/*.conf;
    include upstreams/*.conf;
    include sites/*.conf;
}
# forgebox:end main
