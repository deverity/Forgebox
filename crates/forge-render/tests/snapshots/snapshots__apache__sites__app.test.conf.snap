---
source: crates/forge-render/tests/snapshots.rs
expression: content
---
# generated by forgebox — edits will be lost; override via etc/templates/
<VirtualHost 127.0.0.1:80>
    ServerName app.test
    RewriteEngine On
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</VirtualHost>

<VirtualHost 127.0.0.1:443>
    ServerName app.test
    Include "C:/fb-test/etc/apache/snippets/ssl-app.test.conf"
    ProxyRequests Off
    ProxyPreserveHost On
    RequestHeader set X-Forwarded-Proto https
    RequestHeader set FORGEBOX_SITE "app.test"
    # mod_proxy answers 503 when the backend refuses the connection (AH00957), 502 on bad replies.
    # A local path keeps the error document an internal redirect (an absolute URL would redirect the client).
    ProxyPass "/_forgebox/starting" "http://127.0.0.1:19000/_forgebox/starting"
    ErrorDocument 502 "/_forgebox/starting?host=app.test"
    ErrorDocument 503 "/_forgebox/starting?host=app.test"
    ProxyPass "/" "http://127.0.0.1:3000/" upgrade=websocket timeout=3600
    ProxyPassReverse "/" "http://127.0.0.1:3000/"
</VirtualHost>
