---
source: crates/forge-render/tests/snapshots.rs
expression: content
---
# generated by forgebox — edits will be lost; override via etc/templates/
server {
    listen 127.0.0.1:80;
    server_name loja.test *.loja.test admin.loja.test;
    return 301 https://$host$request_uri;
}

server {
    listen 127.0.0.1:443 ssl;
    http2 on;
    server_name loja.test *.loja.test admin.loja.test;
    root "C:/fb-test/www/loja/public";
    index index.php index.html;
    include snippets/ssl-loja.test.conf;
    include snippets/php-common.conf;
    client_max_body_size 256M;
    add_header X-Frame-Options "SAMEORIGIN" always;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ /\.ht {
        deny all;
    }

    location ~ /\.env {
        deny all;
    }

    location ~ \.(?:css|js|png|svg|woff2)$ {
        add_header Cache-Control "public, max-age=86400";
        try_files $uri =404;
    }

    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param FORGEBOX_SITE loja.test;
        fastcgi_param APP_ENV "local";
        fastcgi_pass php_8_3;
    }
}
