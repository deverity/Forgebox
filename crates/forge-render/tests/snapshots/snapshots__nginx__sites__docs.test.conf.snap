---
source: crates/forge-render/tests/snapshots.rs
expression: content
---
# generated by forgebox — edits will be lost; override via etc/templates/
server {
    listen 127.0.0.1:80;
    server_name docs.test;
    root "C:/fb-test/www/docs";
    index index.html index.htm;
    client_max_body_size 256M;

    location / {
        try_files $uri $uri/ =404;
    }

    location ~ /\.ht {
        deny all;
    }

    location ~ /\.env {
        deny all;
    }
}
