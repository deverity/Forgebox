# generated by forgebox — edits will be lost; override via etc/templates/
<VirtualHost 127.0.0.1:80>
    ServerName docs.test
    DocumentRoot "C:/fb-test/www/docs"
    DirectoryIndex index.html index.htm
    <Directory "C:/fb-test/www/docs">
        Options FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>
    <LocationMatch "/\.ht">
        Require all denied
    </LocationMatch>
    <LocationMatch "/\.env">
        Require all denied
    </LocationMatch>
</VirtualHost>
