---
source: crates/forge-render/tests/snapshots.rs
expression: content
---
# generated by forgebox — edits will be lost; override via etc/templates/
server {
    listen 127.0.0.1:80;
    server_name app.test;
    return 301 https://$host$request_uri;
}

server {
    listen 127.0.0.1:443 ssl;
    http2 on;
    server_name app.test;
    include snippets/ssl-app.test.conf;
    client_max_body_size 256M;
    error_page 502 = /_forgebox/starting;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header FORGEBOX_SITE app.test;
        proxy_read_timeout 3600s;
        proxy_buffering off;
    }

    # Page shown while the app behind this proxy is being started (docs/06 section 8).
    location = /_forgebox/starting {
        internal;
        proxy_pass http://127.0.0.1:19000/_forgebox/starting?host=app.test;
        proxy_set_header Host $host;
    }
}
