<!doctype html>
<html lang="{{ t.lang | html }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% if refresh_secs %}
<meta http-equiv="refresh" content="{{ refresh_secs }}">
{% endif %}
<title>{{ t.title | html }}</title>
<style>
  :root { color-scheme: light dark; }
  body { margin: 0; min-height: 100vh; display: grid; place-items: center;
         font: 16px/1.5 system-ui, "Segoe UI", sans-serif; background: #f5f5f7; color: #1d1d1f; }
  @media (prefers-color-scheme: dark) { body { background: #1c1c1e; color: #f5f5f7; } }
  main { text-align: center; max-width: 32rem; padding: 2rem; }
  .spinner { width: 2.5rem; height: 2.5rem; margin: 0 auto 1.5rem; border-radius: 50%;
             border: 3px solid rgba(128, 128, 128, .3); border-top-color: #0a84ff;
             animation: spin 0.9s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  h1 { font-size: 1.4rem; margin: 0 0 .5rem; }
  p { margin: .25rem 0; opacity: .75; }
  code { font-family: ui-monospace, Consolas, monospace; }
</style>
</head>
<body>
<main>
  <div class="spinner" role="status" aria-label="{{ t.title | html }}"></div>
  <h1>{{ t.heading | html }}</h1>
  <p>{{ t.body | html }}</p>
{% if state %}
  <p><code>{{ host | html }}</code> &middot; {{ state | html }}</p>
{% else %}
  <p><code>{{ host | html }}</code></p>
{% endif %}
{% if detail %}
  <p>{{ detail | html }}</p>
{% endif %}
  <p>{{ t.hint | html }}</p>
</main>
</body>
</html>
