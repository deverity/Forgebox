ServerRoot "{{ tool.dir }}"
ServerName 127.0.0.1
ServerTokens Prod
ServerSignature Off
Listen 127.0.0.1:{{ prefs.http_port }}
Listen 127.0.0.1:{{ prefs.https_port }}
PidFile "{{ paths.tmp }}/apache/httpd.pid"

LoadModule alias_module modules/mod_alias.so
LoadModule authz_core_module modules/mod_authz_core.so
LoadModule authz_host_module modules/mod_authz_host.so
LoadModule dir_module modules/mod_dir.so
LoadModule env_module modules/mod_env.so
LoadModule headers_module modules/mod_headers.so
LoadModule http2_module modules/mod_http2.so
LoadModule lbmethod_bybusyness_module modules/mod_lbmethod_bybusyness.so
LoadModule log_config_module modules/mod_log_config.so
LoadModule mime_module modules/mod_mime.so
LoadModule proxy_module modules/mod_proxy.so
LoadModule proxy_balancer_module modules/mod_proxy_balancer.so
LoadModule proxy_fcgi_module modules/mod_proxy_fcgi.so
LoadModule proxy_http_module modules/mod_proxy_http.so
LoadModule proxy_wstunnel_module modules/mod_proxy_wstunnel.so
LoadModule rewrite_module modules/mod_rewrite.so
LoadModule setenvif_module modules/mod_setenvif.so
LoadModule slotmem_shm_module modules/mod_slotmem_shm.so
LoadModule socache_shmcb_module modules/mod_socache_shmcb.so
LoadModule ssl_module modules/mod_ssl.so

<Directory />
    AllowOverride None
    Require all denied
</Directory>

TypesConfig "{{ tool.dir }}/conf/mime.types"
DirectoryIndex index.php index.html
AddDefaultCharset UTF-8
EnableSendfile Off
# Quick settings (docs/04 section 1.3).
KeepAlive {{ instance.settings.keep_alive | default('On') }}
Timeout {{ instance.settings.timeout | default('300') }}
LimitRequestBody {{ instance.settings.limit_request_body | default('0') }}
Mutex default
SSLProtocol -all +TLSv1.2 +TLSv1.3
SSLSessionCache "shmcb:{{ paths.tmp }}/apache/ssl_scache(512000)"

ErrorLog "{{ paths.logs }}/apache/error.log"
LogLevel warn
# Structured access log consumed by forge-metrics (docs/14 section 2). rt_us is in microseconds.
LogFormat "{\"t\":\"%{msec}t\",\"host\":\"%{Host}i\",\"s\":%s,\"rt_us\":%D,\"b\":%B,\"m\":\"%m\",\"u\":\"%U\",\"up\":\"%{BALANCER_WORKER_NAME}e\"}" forgebox_json
CustomLog "{{ paths.logs }}/apache/access.json" forgebox_json

# Unknown hosts never fall into a real site (first VirtualHost of a port is its default).
<VirtualHost 127.0.0.1:{{ prefs.http_port }}>
    ServerName _default_
    RedirectMatch 404 ^
</VirtualHost>

IncludeOptional "{{ paths.etc }}/apache/conf.d/*.conf"
IncludeOptional "{{ paths.etc }}/apache/upstreams/*.conf"
IncludeOptional "{{ paths.etc }}/apache/sites/*.conf"
