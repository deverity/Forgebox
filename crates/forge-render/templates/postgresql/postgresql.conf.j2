# minimal template created in M1-E1-T2; completed in M1-E4-T1
# forgebox:begin postgresql.conf
# generated by forgebox: edits inside this block will be lost; override via etc/templates/postgresql/postgresql.conf.j2
listen_addresses = '127.0.0.1'
port = {{ instance.ports.main }}
max_connections = 100
shared_buffers = 128MB
# Development defaults: favor speed over durability.
fsync = on
synchronous_commit = off
logging_collector = on
log_directory = '{{ paths.logs | posix_path }}/postgresql/{{ instance.name }}'
log_filename = 'postgresql.log'
log_timezone = 'UTC'
timezone = 'UTC'
client_encoding = 'UTF8'
# forgebox:end postgresql.conf
