[client]
port = {{ instance.ports.main }}
host = 127.0.0.1
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4

[mysqld]
basedir = "{{ tool.dir }}"
datadir = "{{ instance.data_dir }}"
port = {{ instance.ports.main }}
bind-address = 127.0.0.1
mysqlx = OFF
named-pipe = OFF
shared-memory = OFF
pid-file = "{{ paths.tmp }}/mysql/{{ instance.name }}.pid"
log-error = "{{ paths.logs }}/mysql/{{ instance.name }}/error.log"
character-set-server = utf8mb4
collation-server = utf8mb4_0900_ai_ci
lower_case_table_names = {{ 0 if instance.case_sensitive else 2 }}
max_allowed_packet = {{ instance.settings.max_allowed_packet | default('256M') }}
sql_mode = ONLY_FULL_GROUP_BY,STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION
explicit_defaults_for_timestamp = ON
max_connections = {{ instance.settings.max_connections | default('200') }}
innodb_buffer_pool_size = {{ instance.settings.innodb_buffer_pool_size | default('256M') }}
# Development defaults: favor speed over durability.
innodb_flush_log_at_trx_commit = {{ instance.settings.innodb_flush_log_at_trx_commit | default('2') }}
innodb_flush_method = unbuffered
slow_query_log = {{ instance.settings.slow_query_log | default('0') }}
slow_query_log_file = "{{ paths.logs }}/mysql/{{ instance.name }}/slow.log"
long_query_time = {{ instance.settings.long_query_time | default('1') }}

[mysqldump]
quick
max_allowed_packet = {{ instance.settings.max_allowed_packet | default('256M') }}
