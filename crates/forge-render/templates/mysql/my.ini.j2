# minimal template created in M1-E1-T2; completed in M1-E4-T1
# forgebox:begin my.ini
# generated by forgebox: edits inside this block will be lost; override via etc/templates/mysql/my.ini.j2
[client]
host=127.0.0.1
port={{ instance.ports.main }}
default-character-set=utf8mb4

[mysqld]
bind-address=127.0.0.1
port={{ instance.ports.main }}
mysqlx=OFF
named-pipe=OFF
shared-memory=OFF
datadir={{ instance.data_dir | posix_path }}
log-error={{ paths.logs | posix_path }}/mysql/{{ instance.name }}/error.log

# Linux parity (docs/15 section 5): 0 = case-sensitive table names. Only when the data dir
# is a case-sensitive NTFS directory; otherwise 2. Never change on an initialized instance.
lower_case_table_names={{ 0 if instance.case_sensitive else 2 }}

character-set-server=utf8mb4
collation-server=utf8mb4_0900_ai_ci
max_connections=151
max_allowed_packet=64M
sql_mode=ONLY_FULL_GROUP_BY,STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION
explicit_defaults_for_timestamp=ON

# InnoDB defaults for development: favor speed over durability.
innodb_buffer_pool_size=256M
innodb_flush_log_at_trx_commit=2
innodb_flush_method=unbuffered

[mysqldump]
quick
max_allowed_packet=64M
# forgebox:end my.ini
