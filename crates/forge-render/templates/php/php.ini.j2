date.timezone = "{{ prefs.timezone | default('UTC') }}"
default_charset = "UTF-8"
extension_dir = "{{ paths.version | posix_path }}/ext"
sys_temp_dir = "{{ paths.tmp | posix_path }}/php/{{ series }}"
upload_tmp_dir = "{{ paths.tmp | posix_path }}/php/{{ series }}"
session.save_path = "{{ paths.tmp | posix_path }}/php/{{ series }}/sessions"
error_log = "{{ paths.logs | posix_path }}/php/{{ series }}/error.log"
log_errors = On
{% for name in extensions | default([]) %}
extension={{ name }}
{% endfor %}
