; Xdebug for PHP {{ php.series }}. xdebug.mode=off keeps the extension loaded but inert.
zend_extension = xdebug

[xdebug]
xdebug.mode = {{ php.xdebug.mode }}
xdebug.start_with_request = {{ php.xdebug.start_with_request }}
xdebug.client_host = 127.0.0.1
xdebug.client_port = {{ php.xdebug.client_port }}
xdebug.discover_client_host = 0
