---
source: crates/forge-sites/tests/drivers.rs
expression: loja_conf
---
# generated by forgebox — edits will be lost; override via etc/templates/
server {
    listen 127.0.0.1:80;
    server_name loja.test *.loja.test admin.loja.test;
    return 301 https://$host$request_uri;
}

server {
    listen 127.0.0.1:443 ssl;
    http2 on;
    server_name loja.test *.loja.test admin.loja.test;
    root "C:/fb-test/www/loja/public";
    index index.php index.html;
    include snippets/ssl-loja.test.conf;
    include snippets/php-common.conf;
    client_max_body_size 256M;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ /\.ht {
        deny all;
    }

    location ~ /\.env {
        deny all;
    }

    location ~ /\.git {
        deny all;
    }

    location ~ \.php$ {
        # Path-info guard: php-cgi has no security.limit_extensions, so never let it
        # walk back from /x.jpg/y.php to an existing non-PHP file.
        fastcgi_split_path_info ^(.+?\.php)(/.*)$;
        # try_files resets $fastcgi_path_info (nginx trac #321): keep it in a variable first.
        set $path_info $fastcgi_path_info;
        try_files $fastcgi_script_name =404;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $path_info;
        fastcgi_param FORGEBOX_SITE loja.test;
        fastcgi_pass php_8_4__loja-test;
    }
}
