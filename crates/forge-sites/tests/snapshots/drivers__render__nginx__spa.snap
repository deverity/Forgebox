---
source: crates/forge-sites/tests/drivers.rs
expression: "render_site(\"nginx\", \"1.30.6\", \"spa\", \"spa\", \"dist\")"
---
# generated by forgebox — edits will be lost; override via etc/templates/
server {
    listen 127.0.0.1:80;
    server_name spa.test *.spa.test admin.spa.test;
    return 301 https://$host$request_uri;
}

server {
    listen 127.0.0.1:443 ssl;
    http2 on;
    server_name spa.test *.spa.test admin.spa.test;
    root "C:/fb-test/www/spa/dist";
    index index.html index.htm;
    include snippets/ssl-spa.test.conf;
    client_max_body_size 256M;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~ /\.ht {
        deny all;
    }

    location ~ /\.env {
        deny all;
    }

    location ~ /\.git {
        deny all;
    }
}
