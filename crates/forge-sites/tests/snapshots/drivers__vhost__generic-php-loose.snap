---
source: crates/forge-sites/tests/drivers.rs
expression: "model_json(name, driver, root)"
---
{
  "kind": "php",
  "hosts": [
    "generic-php-loose.test",
    "*.generic-php-loose.test",
    "admin.generic-php-loose.test"
  ],
  "root": "C:/fb-test/www/generic-php-loose",
  "index": [
    "index.php",
    "index.html"
  ],
  "php_upstream": "php_8_3",
  "try_files": [
    "$uri",
    "$uri/",
    "/index.php?$query_string"
  ],
  "static_locations": [],
  "deny": [
    "/\\.ht",
    "/\\.env",
    "/\\.git"
  ],
  "headers": {},
  "client_max_body": "256M",
  "ssl": {
    "cert": "C:/fb-test/certs/sites/generic-php-loose.test.crt",
    "key": "C:/fb-test/certs/sites/generic-php-loose.test.key"
  },
  "http_redirect": true,
  "proxy": null,
  "env": {},
  "extra": {
    "apache": null,
    "nginx": null,
    "caddy": null
  },
  "fallback_resource": "/index.php"
}
