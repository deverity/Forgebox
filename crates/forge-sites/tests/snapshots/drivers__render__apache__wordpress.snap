---
source: crates/forge-sites/tests/drivers.rs
expression: "render_site(\"apache\", \"2.4.69\", \"wordpress\", \"wordpress\", \"\")"
---
# generated by forgebox — edits will be lost; override via etc/templates/
<VirtualHost 127.0.0.1:80>
    ServerName wordpress.test
    ServerAlias *.wordpress.test admin.wordpress.test
    RewriteEngine On
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</VirtualHost>

<VirtualHost 127.0.0.1:443>
    ServerName wordpress.test
    ServerAlias *.wordpress.test admin.wordpress.test
    DocumentRoot "C:/fb-test/www/wordpress"
    Include "C:/fb-test/etc/apache/snippets/ssl-wordpress.test.conf"
    DirectoryIndex index.php index.html
    <Directory "C:/fb-test/www/wordpress">
        Options FollowSymLinks
        AllowOverride All
        Require all granted
        FallbackResource /index.php
    </Directory>
    <LocationMatch "/\.ht">
        Require all denied
    </LocationMatch>
    <LocationMatch "/\.env">
        Require all denied
    </LocationMatch>
    <LocationMatch "/\.git">
        Require all denied
    </LocationMatch>
    <LocationMatch "/wp-content/uploads/.*\.php$">
        Require all denied
    </LocationMatch>
    <FilesMatch "\.php$">
        SetHandler "proxy:balancer://php_8_3/"
    </FilesMatch>
    # php-cgi is the only backend on Windows (docs/03 section 2.1). Without GENERIC the
    # SCRIPT_FILENAME is "proxy:fcgi://host:port/C:/..."; with it, "/C:/...". Strip the
    # slash before the drive letter or php-cgi answers "No input file specified.".
    ProxyFCGIBackendType GENERIC
    ProxyFCGISetEnvIf "reqenv('SCRIPT_FILENAME') =~ m#^/([A-Za-z]:/.*)$#" SCRIPT_FILENAME "$1"
    ProxyFCGISetEnvIf "true" FORGEBOX_SITE "wordpress.test"
</VirtualHost>
