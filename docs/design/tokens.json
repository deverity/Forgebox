    "forced-colors": {
      "$description": "CSS system colours applied under @media (forced-colors: active).",
      "bg-canvas": { "$value": "Canvas" },
      "bg-sidebar": { "$value": "Canvas" },
      "bg-surface": { "$value": "Canvas" },
      "bg-surface-2": { "$value": "Canvas" },
