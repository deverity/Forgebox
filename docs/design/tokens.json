{
  "$description": "Forgebox design tokens (DTCG). Source of truth for docs/07 sections 2 and 3. Generated outputs: apps/desktop/src/design/tokens.css and tokens.ts (pnpm -C apps/desktop tokens). Alpha colours are 8-digit hex (#RRGGBBAA). Custom type 'spring' = { stiffness, damping }.",
  "color": {
    "$type": "color",
    "light": {
      "bg-canvas": { "$value": "#F5F5F7", "$description": "Window base. Transparent when vibrancy is on; this solid value is the fallback." },
      "bg-sidebar": { "$value": "#E8E8ED", "$description": "Sidebar material (Acrylic/Mica) or this solid fallback." },
      "bg-surface": { "$value": "#FFFFFF" },
      "bg-surface-2": { "$value": "#F9F9FB" },
      "fg-primary": { "$value": "#1D1D1F" },
      "fg-secondary": { "$value": "#515154" },
      "fg-tertiary": { "$value": "#636366" },
      "stroke": { "$value": "#0000001A", "$description": "Decorative divider (alpha 10%). Exempt from 3:1 (WCAG 1.4.11, decorative)." },
      "stroke-strong": { "$value": "#7C7C80", "$description": "Control border / focus-relevant outline, 3:1 or better." },
      "accent": { "$value": "#0071E3", "$description": "Fallback; the shell overrides --accent with the Windows accent." },
      "fg-on-accent": { "$value": "#FFFFFF", "$description": "Text/icons on an accent fill, 4.5:1 against accent." },
      "state-running": { "$value": "#248A3D" },
      "state-starting": { "$value": "#B25000" },
      "state-stopped": { "$value": "#6E6E73" },
      "state-failed": { "$value": "#D70015" },
      "state-updating": { "$value": "#0071A4" }
    },
    "dark": {
      "bg-canvas": { "$value": "#1C1C1E" },
      "bg-sidebar": { "$value": "#2C2C2E" },
      "bg-surface": { "$value": "#2C2C2E" },
      "bg-surface-2": { "$value": "#3A3A3C" },
      "fg-primary": { "$value": "#F5F5F7" },
      "fg-secondary": { "$value": "#AEAEB2" },
      "fg-tertiary": { "$value": "#A8A8AD" },
      "stroke": { "$value": "#FFFFFF1A" },
      "stroke-strong": { "$value": "#8E8E93" },
      "accent": { "$value": "#0A84FF" },
      "fg-on-accent": { "$value": "#000000", "$description": "Text/icons on an accent fill, 4.5:1 against accent." },
      "state-running": { "$value": "#30D158" },
      "state-starting": { "$value": "#FFD60A" },
      "state-stopped": { "$value": "#8E8E93" },
      "state-failed": { "$value": "#FF453A" },
      "state-updating": { "$value": "#64D2FF" }
    },
    "high-contrast": {
      "bg-canvas": { "$value": "#000000" },
      "bg-sidebar": { "$value": "#000000" },
      "bg-surface": { "$value": "#000000" },
      "bg-surface-2": { "$value": "#000000" },
      "fg-primary": { "$value": "#FFFFFF" },
      "fg-secondary": { "$value": "#FFFFFF" },
      "fg-tertiary": { "$value": "#E6E6E6" },
      "stroke": { "$value": "#FFFFFF" },
      "stroke-strong": { "$value": "#FFFFFF" },
      "accent": { "$value": "#1AEBFF" },
      "fg-on-accent": { "$value": "#000000", "$description": "Text/icons on an accent fill, 4.5:1 against accent." },
      "state-running": { "$value": "#3DFF7F" },
      "state-starting": { "$value": "#FFFF00" },
      "state-stopped": { "$value": "#CCCCCC" },
      "state-failed": { "$value": "#FF8A80" },
      "state-updating": { "$value": "#1AEBFF" }
    },
    "forced-colors": {
      "$description": "CSS system colours applied under @media (forced-colors: active).",
      "bg-canvas": { "$value": "Canvas" },
      "bg-sidebar": { "$value": "Canvas" },
      "bg-surface": { "$value": "Canvas" },
      "bg-surface-2": { "$value": "Canvas" },
      "fg-primary": { "$value": "CanvasText" },
      "fg-secondary": { "$value": "CanvasText" },
      "fg-tertiary": { "$value": "GrayText" },
      "stroke": { "$value": "CanvasText" },
      "stroke-strong": { "$value": "CanvasText" },
      "accent": { "$value": "Highlight" },
      "fg-on-accent": { "$value": "HighlightText", "$description": "Text/icons on an accent fill, 4.5:1 against accent." },
      "state-running": { "$value": "CanvasText" },
      "state-starting": { "$value": "CanvasText" },
      "state-stopped": { "$value": "GrayText" },
      "state-failed": { "$value": "Mark" },
      "state-updating": { "$value": "LinkText" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["SF Pro Text", "Segoe UI Variable Text", "Segoe UI", "Inter", "system-ui", "sans-serif"] },
      "mono": { "$value": ["Cascadia Code", "JetBrains Mono", "ui-monospace", "monospace"] }
    },
    "feature": {
      "tnum": { "$type": "other", "$value": "\"tnum\"" }
    }
  },
  "typography": {
    "$type": "typography",
    "$description": "Scale from docs/07 2.1 (px / line-height / weight). Nothing below 11px. tnum = tabular numerals.",
    "display": { "$value": { "fontSize": "28px", "lineHeight": "34px", "fontWeight": 600, "fontFamily": "sans" }, "$extensions": { "forgebox": { "tnum": false } } },
    "title-1": { "$value": { "fontSize": "22px", "lineHeight": "28px", "fontWeight": 600, "fontFamily": "sans" }, "$extensions": { "forgebox": { "tnum": false } } },
    "title-2": { "$value": { "fontSize": "17px", "lineHeight": "22px", "fontWeight": 600, "fontFamily": "sans" }, "$extensions": { "forgebox": { "tnum": false } } },
    "headline": { "$value": { "fontSize": "15px", "lineHeight": "20px", "fontWeight": 600, "fontFamily": "sans" }, "$extensions": { "forgebox": { "tnum": false } } },
    "body": { "$value": { "fontSize": "13px", "lineHeight": "18px", "fontWeight": 400, "fontFamily": "sans" }, "$extensions": { "forgebox": { "tnum": false } } },
    "callout": { "$value": { "fontSize": "12px", "lineHeight": "16px", "fontWeight": 400, "fontFamily": "sans" }, "$extensions": { "forgebox": { "tnum": false } } },
    "caption": { "$value": { "fontSize": "11px", "lineHeight": "14px", "fontWeight": 400, "fontFamily": "sans" }, "$extensions": { "forgebox": { "tnum": false } } },
    "label": { "$value": { "fontSize": "11px", "lineHeight": "14px", "fontWeight": 600, "fontFamily": "sans", "letterSpacing": "0.04em" }, "$extensions": { "forgebox": { "tnum": false } } },
    "mono": { "$value": { "fontSize": "12px", "lineHeight": "18px", "fontWeight": 400, "fontFamily": "mono" }, "$extensions": { "forgebox": { "tnum": true } } }
  },
  "space": {
    "$type": "dimension",
    "$description": "4px grid; names are multiples of 4px.",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "10": { "$value": "40px" }
  },
  "radius": {
    "$type": "dimension",
    "control": { "$value": "6px" },
    "card": { "$value": "10px" },
    "sheet": { "$value": "12px" },
    "window": { "$value": "8px" }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Only popovers, sheets and toasts (docs/07 2.5).",
    "light": {
      "popover": { "$value": { "color": "#00000014", "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "0px" } }
    },
    "dark": {
      "popover": { "$value": { "color": "#0000002E", "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "0px" } }
    }
  },
  "motion": {
    "spring": {
      "$type": "spring",
      "layout": { "$value": { "stiffness": 380, "damping": 32 }, "$description": "Layout and shared-element transitions." },
      "popover": { "$value": { "stiffness": 260, "damping": 26 } },
      "toggle": { "$value": { "stiffness": 500, "damping": 40 } }
    },
    "duration": {
      "$type": "duration",
      "micro": { "$value": "120ms" },
      "transition": { "$value": "220ms" },
      "sheet": { "$value": "280ms" },
      "reduced": { "$value": "100ms", "$description": "prefers-reduced-motion: every motion becomes an opacity fade of this duration." }
    }
  }
}
