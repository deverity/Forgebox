{
  "$description": "Forgebox design tokens (DTCG). Source of truth for docs/07 sections 2 and 3. Generated outputs: apps/desktop/src/design/tokens.css and tokens.ts (pnpm -C apps/desktop tokens). Alpha colours are 8-digit hex (#RRGGBBAA). Custom type 'spring' = { stiffness, damping }.",
  "color": {
    "$type": "color",
    "light": {
      "bg-canvas": { "$value": "#F5F5F7", "$description": "Window base. Transparent when vibrancy is on; this solid value is the fallback." },
      "bg-sidebar": { "$value": "#E8E8ED", "$description": "Sidebar over the window material (transparent with Mica/Acrylic, bg-sidebar-glass over the Windows 10 blur) or this solid fallback." },
      "bg-surface": { "$value": "#FFFFFF" },
      "bg-surface-2": { "$value": "#F9F9FB" },
      "fg-primary": { "$value": "#1D1D1F" },
      "fg-secondary": { "$value": "#515154" },
      "fg-tertiary": { "$value": "#636366" },
      "stroke": { "$value": "#0000001A", "$description": "Decorative divider (alpha 10%). Exempt from 3:1 (WCAG 1.4.11, decorative)." },
      "stroke-strong": { "$value": "#7C7C80", "$description": "Control border / focus-relevant outline, 3:1 or better." },
      "accent": { "$value": "#0071E3", "$description": "Fallback; the shell overrides --accent with the Windows accent." },
      "accent-hover": { "$value": "#0062C4", "$description": "Primary fill on hover; the shell derives it from the Windows accent (away from --fg-on-accent), so text keeps 4.5:1. No opacity on text." },
      "accent-pressed": { "$value": "#0053A6", "$description": "Primary fill while pressed; same derivation, stronger." },
      "fg-on-accent": { "$value": "#FFFFFF", "$description": "Text/icons on an accent fill, 4.5:1 against accent." },
      "state-running": { "$value": "#248A3D" },
      "state-starting": { "$value": "#B25000" },
      "state-stopped": { "$value": "#6E6E73" },
      "state-failed": { "$value": "#D70015" },
      "state-updating": { "$value": "#0071A4" },
      "bg-sidebar-glass": { "$value": "#F6F4FA9E", "$description": "Sidebar tint painted over the Windows 10 DWM blur (data-effect=blur): rgba(246,244,250,.62), from the approved glass mockup (M2-E1-T23). Text contrast is checked on the solid fallback." },
      "fill": { "$value": "#0000000D", "$description": "Soft fill of secondary buttons, the search field and chips (5%). No outline." },
      "fill-hover": { "$value": "#00000017", "$description": "Soft fill on hover (9%)." },
      "fill-pressed": { "$value": "#00000024", "$description": "Soft fill while pressed (14%)." },
      "fill-selected": { "$value": "#00000014", "$description": "Selected sidebar row (8%), 7 px radius." },
      "stroke-control": { "$value": "#00000000", "$description": "Border of soft controls: transparent here, visible in high contrast (and forced colours draw it)." },
      "window-minimize": { "$value": "#FEBC2E", "$description": "Minimize dot (yellow), docs/07 section 4." },
      "window-maximize": { "$value": "#28C840", "$description": "Maximize/restore dot (green)." },
      "window-close": { "$value": "#FF5F57", "$description": "Close dot (red)." },
      "window-inactive": { "$value": "#D6D5DB", "$description": "All three dots while the window is not focused." },
      "window-dot-stroke": { "$value": "#0000002E", "$description": "Thin inner stroke of the dots (18%)." },
      "window-glyph": { "$value": "#0000008C", "$description": "Glyph inside a dot on hover (55%)." },
      "fg-on-tool": { "$value": "#FFFFFF", "$description": "Monogram/icon on a tool tile, 4.5:1 against every tool-* colour." },
      "tool-1": { "$value": "#1F6FD1" },
      "tool-2": { "$value": "#00758F" },
      "tool-3": { "$value": "#C42B1C" },
      "tool-4": { "$value": "#6B4FBB" },
      "tool-5": { "$value": "#2E7D32" },
      "tool-6": { "$value": "#B3541E" },
      "tool-7": { "$value": "#AD1457" },
      "tool-8": { "$value": "#546E7A", "$description": "Tool tile palette: the colour is picked from the tool id (FNV-1a), never from the manifest." }
    },
    "dark": {
      "bg-canvas": { "$value": "#1C1C1E" },
      "bg-sidebar": { "$value": "#2C2C2E" },
      "bg-surface": { "$value": "#2C2C2E" },
      "bg-surface-2": { "$value": "#3A3A3C" },
      "fg-primary": { "$value": "#F5F5F7" },
      "fg-secondary": { "$value": "#AEAEB2" },
      "fg-tertiary": { "$value": "#A8A8AD" },
      "stroke": { "$value": "#FFFFFF1A" },
      "stroke-strong": { "$value": "#8E8E93" },
      "accent": { "$value": "#0A84FF" },
      "accent-hover": { "$value": "#3D9BFF", "$description": "Primary fill on hover; the shell derives it from the Windows accent (away from --fg-on-accent), so text keeps 4.5:1. No opacity on text." },
      "accent-pressed": { "$value": "#66B0FF", "$description": "Primary fill while pressed; same derivation, stronger." },
      "fg-on-accent": { "$value": "#000000", "$description": "Text/icons on an accent fill, 4.5:1 against accent." },
