      "state-updating": { "$value": "#64D2FF" },
      "bg-sidebar-glass": { "$value": "#26242E94", "$description": "rgba(38,36,46,.58) over the DWM blur." },
      "fill": { "$value": "#FFFFFF12" },
      "fill-hover": { "$value": "#FFFFFF1F" },
      "fill-pressed": { "$value": "#FFFFFF2E" },
      "fill-selected": { "$value": "#FFFFFF1A" },
      "stroke-control": { "$value": "#00000000" },
      "window-minimize": { "$value": "#FEBC2E" },
      "window-maximize": { "$value": "#28C840" },
      "window-close": { "$value": "#FF5F57" },
      "window-inactive": { "$value": "#4A4953" },
      "window-dot-stroke": { "$value": "#0000002E" },
      "window-glyph": { "$value": "#0000008C" },
      "fg-on-tool": { "$value": "#FFFFFF" },
      "tool-1": { "$value": "#1F6FD1" },
      "tool-2": { "$value": "#00758F" },
      "tool-3": { "$value": "#C42B1C" },
      "tool-4": { "$value": "#6B4FBB" },
      "tool-5": { "$value": "#2E7D32" },
