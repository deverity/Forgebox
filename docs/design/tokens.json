      "state-running": { "$value": "#3DFF7F" },
      "state-starting": { "$value": "#FFFF00" },
      "state-stopped": { "$value": "#CCCCCC" },
      "state-failed": { "$value": "#FF8A80" },
      "state-updating": { "$value": "#1AEBFF" },
      "bg-sidebar-glass": { "$value": "#000000", "$description": "Never translucent in high contrast." },
      "fill": { "$value": "#000000" },
      "fill-hover": { "$value": "#333333" },
      "fill-pressed": { "$value": "#4D4D4D" },
